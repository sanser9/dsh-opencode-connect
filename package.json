{
  "name": "dsh-opencode-connect",
  "displayName": "DSH OpenCode Connect",
  "description": "把 OpenCode 的免费模型接入 DeepSeek Harness — bring OpenCode free models into DSH with zero configuration.",
  "version": "0.1.0",
  "author": "sanser9",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanser9/dsh-opencode-connect.git"
  },
  "homepage": "https://github.com/sanser9/dsh-opencode-connect#readme",
  "bugs": "https://github.com/sanser9/dsh-opencode-connect/issues",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "opencode",
    "model-provider",
    "free-models"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
